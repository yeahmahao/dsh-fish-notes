{
  "name": "dsh-fish-notes",
  "version": "0.2.0",
  "description": "不乖鱼鱼的碎碎念：把浏览和想法随手记下来，在 DSH 侧栏里按天翻看，右侧还有一张记忆图谱。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "不乖鱼鱼",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "notes",
    "journal",
    "sidebar",
    "graph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeahmahao/dsh-fish-notes.git"
  },
  "homepage": "https://github.com/yeahmahao/dsh-fish-notes",
  "bugs": {
    "url": "https://github.com/yeahmahao/dsh-fish-notes/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.3 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
